function forgeInit(){state.routines??=[];state.goals??=[];state.customExercises??=[];state.media??={};state.catalogFilter??={q:'',muscle:'All',equipment:'All'};state.exerciseReturn??='library';save()}
forgeInit();
function safe(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function jsarg(s){return JSON.stringify(String(s)).replace(/</g,'\\u003c').replace(/'/g,'\\u0027')}
function catalog(){let m=new Map();const add=(name,muscle,equipment,source)=>{if(!m.has(name.toLowerCase()))m.set(name.toLowerCase(),{name,muscle,equipment,source})};catalogExtras.forEach(([n,m,e])=>add(n,m,e,'catalog'));state.programs.forEach(p=>p.workouts.forEach(w=>w.exercises.forEach(e=>add(e.name,e.muscles?.[0]||'Strength','Gym','program'))));stretches.forEach(r=>r.items.forEach(([n])=>add(n,'Mobility','Bodyweight','mobility')));homeWorkouts.forEach(w=>w.ex.forEach(n=>add(n,'Strength',w.equipment,'home')));state.customExercises.forEach(e=>add(e.name,e.muscle,e.equipment,'custom'));return [...m.values()].sort((a,b)=>a.name.localeCompare(b.name))}
function getExercise(name){return catalog().find(e=>e.name===name)||{name,muscle:'Strength',equipment:'Gym'}}
function instructions(e){if(technique[e.name])return technique[e.name];let n=e.name.toLowerCase();if(e.muscle==='Mobility'||/stretch|mobility|hold|rotation|car[s]?|switch/.test(n))return ['Move into the position gradually and keep breathing naturally.','Use a comfortable range of motion; do not force or bounce into discomfort.','Hold or move slowly for the prescribed duration, then switch sides if applicable.'];if(/squat|lunge|press|step-up/.test(n)&&e.muscle==='Legs')return ['Set your feet in a stable position and brace your torso.','Lower under control through a comfortable range of motion.','Drive through the foot while keeping knees tracking naturally.'];if(/row|pulldown|pull-up|chin-up/.test(n))return ['Start with shoulders controlled and torso stable.','Pull through the elbows without swinging your body.','Return slowly and allow a comfortable stretch.'];if(/curl/.test(n))return ['Keep upper arms steady and wrists neutral.','Curl through a comfortable range without swinging.','Lower slowly, controlling the weight.'];if(/press|push-up|dip/.test(n))return ['Set a stable body position and brace your trunk.','Lower with control while keeping joints comfortably aligned.','Press without bouncing or forcing an uncomfortable range.'];return ['Set up the equipment and choose a manageable resistance.','Brace and move through a controlled, comfortable range.','Keep technique consistent and stop if you feel sharp pain.']}
function library(){let f=state.catalogFilter;let all=catalog();let muscles=['All',...new Set(all.map(x=>x.muscle))].sort();let eqs=['All',...new Set(all.map(x=>x.equipment))].sort();let matches=all.filter(x=>(f.muscle==='All'||x.muscle===f.muscle)&&(f.equipment==='All'||x.equipment===f.equipment)&&x.name.toLowerCase().includes(f.q.toLowerCase()));return layout(`<div class="row"><div><div class="sub">MOVEMENT DATABASE</div><h1>Explore exercises</h1></div><span class="pill active">${all.length} exercises</span></div><p class="sub">Search movements, learn technique and add exercises to any workout.</p><div class="card"><label>Search</label><input placeholder="Search exercises..." value="${safe(f.q)}" oninput="setCatalogFilter('q',this.value)"><div class="grid two"><div><label>Muscle / category</label><select onchange="setCatalogFilter('muscle',this.value)">${muscles.map(m=>`<option ${f.muscle===m?'selected':''}>${safe(m)}</option>`).join('')}</select></div><div><label>Equipment</label><select onchange="setCatalogFilter('equipment',this.value)">${eqs.map(e=>`<option ${f.equipment===e?'selected':''}>${safe(e)}</option>`).join('')}</select></div></div></div><div class="sub section">${matches.length} results</div><div class="stack">${matches.map(e=>`<div class="card row"><div style="min-width:0"><h3>${safe(e.name)}</h3><div class="sub">${safe(e.muscle)} • ${safe(e.equipment)}</div></div><div class="row" style="gap:6px"><button class="btn secondary small" onclick='viewCatalogExercise(${jsarg(e.name)})'>Details</button>${state.currentWorkout?`<button class="btn small" onclick='addToSession(${jsarg(e.name)})'>+ Add</button>`:''}</div></div>`).join('')||'<div class="card sub">No matches. Try a different filter.</div>'}</div><div class="card section"><h3>Create your own exercise</h3><label>Exercise name</label><input id="newExName" placeholder="Your exercise"><label>Muscle group</label><input id="newExMuscle" placeholder="e.g. Back"><label>Equipment</label><input id="newExEquipment" placeholder="e.g. Cable"><button class="btn section" onclick="createExercise()">Add exercise</button></div>`,'library')}
window.setCatalogFilter=(key,value)=>{state.catalogFilter[key]=value;save();if(key==='q'){let pos=$('#app input[placeholder="Search exercises..."]')?.selectionStart;render();let el=$('#app input[placeholder="Search exercises..."]');el?.focus();try{el?.setSelectionRange(pos,pos)}catch{}}else render()};
window.createExercise=()=>{let name=$('#newExName').value.trim(),muscle=$('#newExMuscle').value.trim()||'Strength',equipment=$('#newExEquipment').value.trim()||'Other';if(!name)return alert('Enter an exercise name');if(catalog().some(e=>e.name.toLowerCase()===name.toLowerCase()))return alert('This exercise already exists');state.customExercises.push({name,muscle,equipment});save();render()};
window.viewCatalogExercise=name=>{state.exerciseReturn=state.route;state.exercise=name;state.route='exercise';save();render()};
function videoEmbed(name){let u=state.media?.[name]||'';if(!u)return `<div class="video">No video added yet</div><p class="sub">Add your own demonstration URL below (MP4 or YouTube). We don't substitute unrelated videos for technique instruction.</p>`;try{let url=new URL(u),id='';if(url.hostname==='youtu.be')id=url.pathname.slice(1);if(/(^|\.)youtube\.com$/.test(url.hostname))id=url.searchParams.get('v')||url.pathname.match(/^\/shorts\/([^/]+)/)?.[1]||'';if(id&&/^[a-zA-Z0-9_-]{11}$/.test(id))return `<iframe class="mediaframe" src="https://www.youtube-nocookie.com/embed/${id}" title="${safe(name)} demonstration" allow="accelerometer; encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe>`;if(url.protocol==='https:'&&/\.mp4($|\?)/i.test(url.pathname))return `<video class="mediaframe" src="${safe(u)}" controls playsinline preload="metadata"></video>`;return `<p class="sub">Saved URL: <a href="${safe(u)}" target="_blank" rel="noopener noreferrer">Open demonstration</a></p>`}catch{return '<div class="sub">Invalid media URL</div>'}}
exercisePage=function(){let name=state.exercise||'Push-Up',e=getExercise(name),steps=instructions(e);return layout(`<button class="btn ghost small" onclick="nav(${jsarg(state.exerciseReturn||'library')})">← Back</button><h1>${safe(name)}</h1><p class="sub">${safe(e.muscle)} • ${safe(e.equipment)}</p><div class="section">${videoEmbed(name)}</div><div class="card section"><h3>Exercise demonstration</h3><label>Video URL (YouTube or direct MP4)</label><input id="mediaUrl" type="url" placeholder="https://..." value="${safe(state.media?.[name]||'')}"><button class="btn secondary small section" onclick='saveExerciseMedia(${jsarg(name)})'>Save video URL</button></div><div class="section"><h2>How to perform</h2><div class="steps">${steps.map(s=>`<div class="step">${safe(s)}</div>`).join('')}</div></div><div class="grid two section"><div class="card"><h3>Technique</h3><p class="sub">Controlled movement, stable positioning and a pain-free range of motion. Adapt setup to your anatomy.</p></div><div class="card"><h3>Avoid</h3><p class="sub">Rushing repetitions, using momentum and loading beyond your control.</p></div></div><p class="sub section">Instructions are general guidance, not individualized coaching. Stop if an exercise causes pain.</p>${state.currentWorkout?`<button class="btn section" onclick='addToSession(${jsarg(name)})'>Add to current workout</button>`:''}`,'library')};
window.saveExerciseMedia=name=>{let u=$('#mediaUrl').value.trim();if(u){try{if(new URL(u).protocol!=='https:')throw Error('HTTPS required')}catch{return alert('Enter a valid HTTPS video URL')}}state.media[name]=u;save();render()};
function newSession(name='Quick Workout',exercises=[]){if(state.currentWorkout)return alert('Finish or cancel your current workout first.');state.currentWorkout={programId:'free',workout:name,start:Date.now(),exercises:exercises.map(e=>({...e,setData:Array.from({length:e.sets||3},()=>({weight:'',reps:'',rir:'2',done:false}))}))};state.route='train';save();render()}
window.startEmptyWorkout=()=>{let n=prompt('Workout name','Quick Workout');if(n!==null)newSession(n.trim()||'Quick Workout')};
window.addToSession=name=>{let c=state.currentWorkout;if(!c)return;let item=getExercise(name);c.exercises.push(ex(name,3,item.muscle==='Mobility'?'30-60 sec':'8-12',item.muscle==='Mobility'?0:75,[item.muscle]));let e=c.exercises.at(-1);e.setData=Array.from({length:3},()=>({weight:'',reps:'',rir:'2',done:false}));state.route='train';save();render()};
window.addSetToExercise=ei=>{let e=state.currentWorkout.exercises[ei];e.setData.push({weight:'',reps:'',rir:'2',done:false});e.sets=e.setData.length;save();render()};
window.removeSetFromExercise=ei=>{let e=state.currentWorkout.exercises[ei];if(e.setData.length<=1)return;e.setData.pop();e.sets=e.setData.length;save();render()};
window.removeExerciseFromSession=ei=>{if(!confirm('Remove this exercise from the current workout?'))return;state.currentWorkout.exercises.splice(ei,1);save();render()};
window.saveCurrentAsRoutine=()=>{let c=state.currentWorkout;if(!c||!c.exercises.length)return alert('Add exercises first');let n=prompt('Save routine as',c.workout);if(!n?.trim())return;state.routines.push({id:'r'+Date.now(),name:n.trim(),type:'Gym',exercises:c.exercises.map(({name,sets,reps,rest,muscles,note})=>({name,sets,reps,rest,muscles,note}))});save();alert('Routine saved to Programs')};
train=function(){if(!state.currentWorkout)return layout(`<h1>Train your way</h1><p class="sub">Start from scratch, choose a saved routine, or use a program day.</p><button class="btn full" onclick="startEmptyWorkout()">+ Start empty workout</button><button class="btn secondary full section" onclick="nav('library')">Browse exercise library</button>${state.routines.length?`<div class="section"><h2>My routines</h2>${state.routines.map(r=>`<div class="card row"><div><h3>${safe(r.name)}</h3><div class="sub">${r.exercises.length} exercises</div></div><button class="btn small" onclick='startSavedRoutine(${jsarg(r.id)})'>Start</button></div>`).join('')}</div>`:''}<div class="section"><h2>Program workouts</h2>${activeProgram().workouts.map(w=>`<div class="card row" style="margin-bottom:10px"><div><h3>${safe(w.name)}</h3><div class="sub">${w.est} • ${w.exercises.length} exercises</div></div><button class="btn small" onclick='startWorkout(${jsarg(w.name)})'>Start</button></div>`).join('')}</div>`,'train');let c=state.currentWorkout;return layout(`<div class="row"><div><div class="sub">ACTIVE WORKOUT</div><h1>${safe(c.workout)}</h1></div><button class="btn ghost small" onclick="cancelWorkout()">Cancel</button></div><div class="row section"><button class="btn secondary small" onclick="nav('library')">+ Add exercise</button><button class="btn secondary small" onclick="saveCurrentAsRoutine()">Save as routine</button></div>${c.exercises.map((e,ei)=>`<div class="card section"><div class="row"><div><h3>${safe(e.name)}</h3><div class="sub">${safe(e.reps)} • ${e.rest||'Self-paced'}s rest</div></div><button class="btn ghost small" onclick="removeExerciseFromSession(${ei})">Remove</button></div><button class="linkbtn" onclick='viewCatalogExercise(${jsarg(e.name)})'>Technique & video →</button>${findPrevious(e.name)?`<div class="sub">Previous: ${findPrevious(e.name).map(s=>`${safe(s.weight)}kg × ${safe(s.reps)}`).join(' · ')}</div>`:''}<div class="section">${e.setData.map((s,si)=>`<div class="setrow"><span class="setnum">${si+1}</span><input aria-label="Weight in kg" inputmode="decimal" placeholder="kg" value="${safe(s.weight)}" onchange="setField(${ei},${si},'weight',this.value)"><input aria-label="Repetitions" inputmode="numeric" placeholder="reps" value="${safe(s.reps)}" onchange="setField(${ei},${si},'reps',this.value)"><input aria-label="Reps in reserve" inputmode="numeric" placeholder="RIR" value="${safe(s.rir)}" onchange="setField(${ei},${si},'rir',this.value)"><button class="check ${s.done?'done':''}" onclick="toggleSet(${ei},${si})">${s.done?'✓':'○'}</button></div>`).join('')}</div><div class="row section"><div><button class="btn ghost small" onclick="removeSetFromExercise(${ei})">− Set</button> <button class="btn secondary small" onclick="addSetToExercise(${ei})">+ Set</button></div>${e.rest?`<button class="btn ghost small" onclick="startTimer(${e.rest})">Rest ${e.rest}s</button>`:''}</div></div>`).join('')}<button class="btn secondary full section" onclick="nav('library')">+ Add another exercise</button><button class="btn full section" onclick="finishWorkout()">Finish workout</button>`,'train')};
window.startSavedRoutine=id=>{let r=state.routines.find(r=>r.id===id);if(r)newSession(r.name,r.exercises)};
window.createRoutine=()=>{let name=$('#routineName')?.value.trim(),type=$('#routineType')?.value||'Gym';if(!name)return alert('Name your routine');let r={id:'r'+Date.now(),name,type,exercises:[]};state.routines.push(r);state.editRoutine=r.id;state.route='routine';save();render()};
window.editRoutine=id=>{state.editRoutine=id;state.route='routine';save();render()};
window.addRoutineExercise=()=>{let r=state.routines.find(x=>x.id===state.editRoutine);let name=$('#routineExercise').value;if(!r||!name)return;r.exercises.push(ex(name,3,'8-12',75,[getExercise(name).muscle]));save();render()};
window.removeRoutineExercise=i=>{let r=state.routines.find(x=>x.id===state.editRoutine);r.exercises.splice(i,1);save();render()};
window.updateRoutineExercise=(i,key,value)=>{let r=state.routines.find(x=>x.id===state.editRoutine);r.exercises[i][key]=key==='sets'||key==='rest'?Number(value):value;save()};
window.deleteRoutine=id=>{if(!confirm('Delete this saved routine?'))return;state.routines=state.routines.filter(x=>x.id!==id);save();render()};
function routineEditor(){let r=state.routines.find(x=>x.id===state.editRoutine);if(!r)return programs();return layout(`<button class="btn ghost small" onclick="nav('programs')">← Programs</button><h1>${safe(r.name)}</h1><p class="sub">Edit the exercise list and targets. Changes are saved automatically.</p>${r.exercises.map((e,i)=>`<div class="card section"><div class="row"><h3>${safe(e.name)}</h3><button class="btn ghost small" onclick="removeRoutineExercise(${i})">Remove</button></div><div class="grid three"><div><label>Sets</label><input type="number" min="1" max="15" value="${e.sets}" onchange="updateRoutineExercise(${i},'sets',this.value)"></div><div><label>Reps / time</label><input value="${safe(e.reps)}" onchange="updateRoutineExercise(${i},'reps',this.value)"></div><div><label>Rest (sec)</label><input type="number" min="0" value="${e.rest}" onchange="updateRoutineExercise(${i},'rest',this.value)"></div></div></div>`).join('')}<div class="card section"><h3>Add exercise</h3><select id="routineExercise">${catalog().map(e=>`<option value="${safe(e.name)}">${safe(e.name)} · ${safe(e.muscle)}</option>`).join('')}</select><button class="btn section" onclick="addRoutineExercise()">+ Add to routine</button></div><button class="btn full section" onclick='startSavedRoutine(${jsarg(r.id)})'>Start this routine</button>`,'programs')}
programs=function(){return layout(`<h1>Programs & routines</h1><p class="sub">Create your own workouts. Preset phases are optional.</p><div class="card"><h2>Create a routine</h2><label>Name</label><input id="routineName" placeholder="e.g. Saturday full body"><label>Type</label><select id="routineType"><option>Gym</option><option>Home</option><option>Mobility</option><option>Cardio</option><option>Core</option></select><button class="btn section" onclick="createRoutine()">Create & edit</button></div><div class="section"><h2>My routines</h2>${state.routines.length?state.routines.map(r=>`<div class="card row" style="margin-bottom:8px"><div><h3>${safe(r.name)}</h3><div class="sub">${safe(r.type)} • ${r.exercises.length} exercises</div></div><div class="row" style="gap:5px"><button class="btn secondary small" onclick='editRoutine(${jsarg(r.id)})'>Edit</button><button class="btn small" onclick='startSavedRoutine(${jsarg(r.id)})'>Start</button></div></div>`).join(''):'<p class="sub">No saved routines yet.</p>'}</div><div class="section"><h2>Preset training phases</h2>${state.programs.map(p=>`<div class="card section"><div class="row"><div><h3>${safe(p.name)}</h3><div class="sub">${p.workouts.length} training days • ${p.length} weeks</div></div><button class="btn ${p.id===state.activeProgram?'ghost':'secondary'} small" onclick='activateProgram(${jsarg(p.id)})'>${p.id===state.activeProgram?'Active':'Use'}</button></div></div>`).join('')}</div><div class="section"><h2>Mobility routines</h2>${stretches.map(r=>`<div class="card row section"><div><h3>${safe(r.name)}</h3><div class="sub">${r.items.length} movements</div></div><button class="btn secondary small" onclick='openStretch(${jsarg(r.name)})'>Open</button></div>`).join('')}</div><div class="section"><h2>Home workouts</h2>${homeWorkouts.map(w=>`<div class="card row section"><div><h3>${safe(w.name)}</h3><div class="sub">${safe(w.equipment)} • ${w.ex.length} exercises</div></div><button class="btn secondary small" onclick='startHomeWorkout(${jsarg(w.name)})'>Start</button></div>`).join('')}</div>`,'programs')};
window.startHomeWorkout=name=>{let w=homeWorkouts.find(x=>x.name===name);if(w)newSession(w.name,w.ex.map(n=>ex(n,3,'8-15',60,[getExercise(n).muscle])))};
window.addGoal=()=>{let title=$('#goalTitle').value.trim(),kind=$('#goalKind').value,target=Number($('#goalTarget').value),unit=$('#goalUnit').value.trim(),date=$('#goalDate').value;if(!title||!Number.isFinite(target)||target<=0)return alert('Enter a goal name and positive target');state.goals.push({id:'g'+Date.now(),title,kind,target,unit,date,entries:[],createdAt:new Date().toISOString()});save();render()};
window.logGoal=id=>{let g=state.goals.find(x=>x.id===id),v=prompt('Current value'+(g.unit?' ('+g.unit+')':''));if(v===null)return;let value=Number(v);if(!Number.isFinite(value))return alert('Enter a number');g.entries.push({value,date:new Date().toISOString()});save();render()};
window.deleteGoal=id=>{if(!confirm('Delete this goal?'))return;state.goals=state.goals.filter(x=>x.id!==id);save();render()};
function goals(){return layout(`<h1>My goals</h1><button class="btn ghost small" onclick="nav('settings')">Profile & backups →</button><p class="sub">Create goals that matter to you: strength, bodyweight, consistency, distance or anything measurable.</p><div class="card"><h2>New goal</h2><label>Goal name</label><input id="goalTitle" placeholder="e.g. Bench press 100 kg"><label>Category</label><select id="goalKind"><option>Strength</option><option>Bodyweight</option><option>Consistency</option><option>Cardio</option><option>Mobility</option><option>Other</option></select><div class="grid two"><div><label>Target number</label><input id="goalTarget" inputmode="decimal" type="number" step="any" placeholder="100"></div><div><label>Unit</label><input id="goalUnit" placeholder="kg, workouts, km..."></div></div><label>Target date (optional)</label><input id="goalDate" type="date"><button class="btn section" onclick="addGoal()">Create goal</button></div><div class="section"><h2>Active goals</h2>${state.goals.length?state.goals.map(g=>{let last=g.entries.at(-1)?.value;return `<div class="card section"><div class="row"><div><h3>${safe(g.title)}</h3><div class="sub">${safe(g.kind)} • Target ${g.target} ${safe(g.unit)}${g.date?' by '+safe(g.date):''}</div></div><button class="btn ghost small" onclick='deleteGoal(${jsarg(g.id)})'>Delete</button></div><div class="metric small section">${last===undefined?'Not logged':last+' '+safe(g.unit)}</div><div class="sub">${g.entries.length} check-ins</div><button class="btn secondary small section" onclick='logGoal(${jsarg(g.id)})'>Log progress</button></div>`}).join(''):'<div class="card sub">Create your first personal goal above.</div>'}</div>`,'goals')}
const oldSettings=settings;settings=function(){let original=oldSettings();return original.replace('<h1>Your goals</h1>','<h1>Your profile</h1><button class="btn secondary full" onclick="nav(\'goals\')">Manage personal goals →</button>')};
const oldToday=today;today=function(){let html=oldToday();return html.replace('<div class="section"><h2>Today</h2>','<div class="section grid two"><button class="btn" onclick="startEmptyWorkout()">+ Quick workout</button><button class="btn secondary" onclick="nav(\'library\')">Explore exercises</button><button class="btn secondary" onclick="nav(\'goals\')">My goals</button><button class="btn secondary" onclick="nav(\'programs\')">My routines</button></div><div class="section"><h2>Today</h2>')};
const oldLayout=layout;layout=function(content,active='today'){let html=oldLayout(content,active);html=html.replace('<div class="brand">FORGE</div>','<div class="brand">FORGE <span class="version">V4</span></div>');html=html.replace('<button class="btn ghost small" onclick="nav(\'settings\')">Goals</button>','<button class="btn ghost small" onclick="nav(\'goals\')">My goals</button>');html=html.replace("[['today','Today'],['train','Train'],['programs','Programs'],['progress','Progress'],['settings','You']]","[['today','Home'],['train','Train'],['library','Explore'],['programs','Routines'],['progress','Progress']]");return html};
render=function(){let app=$('#app');if(!state.onboarded){app.innerHTML=onboarding();return}let routes={today,train,library,programs,routine:routineEditor,goals,progress,settings,exercise:exercisePage,stretch:stretchPage};app.innerHTML=(routes[state.route]||today)()};

render();
if('serviceWorker' in navigator) navigator.serviceWorker.register('sw.js').catch(()=>{});

